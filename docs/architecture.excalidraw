   "locked": false,
   "text": "sum C_rent  >=  C_buy\n->  CREATE INDEX",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r3",
   "originalText": "sum C_rent  >=  C_buy\n->  CREATE INDEX",
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "n3",
   "x": 70,
   "y": 510,
   "text": "Both sides live in the planner's own cost units, which is the whole point - rent and buy are only\ncomparable on one scale. Renting until rent equals purchase is the classic 2-competitive strategy:",
   "fontSize": 15,
   "strokeColor": "#1e1e1e",
   "angle": 0,
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 1023,
   "version": 1,
   "versionNonce": 7161,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Both sides live in the planner's own cost units, which is the whole point - rent and buy are only\ncomparable on one scale. Renting until rent equals purchase is the classic 2-competitive strategy:",
   "lineHeight": 1.25,
   "width": 1617.0000000000002,
   "height": 18.75
  },
  {
   "type": "text",
   "id": "n3b",
   "x": 70,
   "y": 560,
   "text": "worst case you pay twice what an oracle with advance knowledge of the workload would have paid.",
